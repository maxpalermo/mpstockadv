<script type="text/javascript">
    function renderTable(response) {
        const data = response.data;
        const pagination = response.pagination;

        const table = document.getElementById("table-search-documents");
        if (table) {
            const tbody = table.querySelector("tbody");
            const tfoot = table.querySelector("tfoot");

            tbody.innerHTML = data;
            tfoot.innerHTML = "";

            if (data) {
                const columns = tbody.querySelector("tr").querySelectorAll("td").length;
                tfoot.innerHTML = `
                                        <tr class="bootstrap">
                                            <th colspan="${columns}">
                                                ${pagination}
                                            </th>
                                        </tr>
                                    `;
                bindPageNumbers();
            }
        }
    }

    async function searchDocuments(page = 1, perPage = 50) {
        const selectElement = document.getElementById('id_order_states');
        const idOrderStates = Array
            .from(selectElement.selectedOptions)
            .map(option => option.value);
        const selectDocumentType = document.getElementById("id_type_document");
        const idTypeDocument = selectDocumentType.value;

        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_search_documents') }}", {
            method: "POST",
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
                idTypeDocument: idTypeDocument,
                idOrderStates: idOrderStates,
                page: page,
                perPage: perPage
            })
        });

        const response = await request.json();
        const table = document.getElementById("table-search-documents");
        if (table) {
            showLoadingOverlay(table);
            renderTable(response);
            hideLoadingOverlay(table);
        }
    }

    function downloadXmlString(xmlString, filename = 'documento.xml') {
        // 1. Creare un Blob dalla stringa XML
        // Specifichiamo il tipo MIME corretto per XML
        const blob = new Blob([xmlString], {
            type: 'application/xml;charset=utf-8'
        });

        // 2. Creare un URL oggetto dal Blob
        const url = URL.createObjectURL(blob);

        // 3. Creare un elemento <a> in memoria
        const a = document.createElement('a');
        a.style.display = 'none'; // Nascondi l'elemento
        document.body.appendChild(a); // Aggiungi l'elemento al DOM (anche se nascosto, è necessario per il clic)

        // 4. Impostare l'attributo href e download
        a.href = url;
        a.download = filename; // Nome del file che verrà scaricato

        // 5. Simulare il clic sull'elemento <a>
        a.click();

        // 6. Rimuovere l'elemento <a> dal DOM e rilasciare l'URL oggetto
        document.body.removeChild(a);
        URL.revokeObjectURL(url); // Rilascia l'URL oggetto per liberare memoria
    }

    function getCurrentDateTimeFormatted() {
        const now = new Date();
        const year = now.getFullYear();
        const month = (now.getMonth() + 1).toString().padStart(2, '0');
        const day = now.getDate().toString().padStart(2, '0');
        const hours = now.getHours().toString().padStart(2, '0');
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const seconds = now.getSeconds().toString().padStart(2, '0');
        return `${year}${month}${day}-${hours}${minutes}${seconds}`;
    }

    async function exportDocuments() {
        const selected = document.querySelectorAll("#table-search-documents tbody input[type=checkbox]:checked");
        if (!selected) {
            alert("Selezionare almeno un documento dall'elenco.");
            return false;
        }

        const ids = Array.from(selected).map(input => input.dataset.id);
        const typeDocument = document.getElementById("id_type_document").value;
        const documentTypeName = document.getElementById("id_type_document").querySelector("option:checked").textContent.trim();

        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_export') }}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
                ids: ids,
                typeDocument: typeDocument
            })
        });

        const response = await request.json();
        if (response.success) {
            const xml = response.xml;
            const currentDate = getCurrentDateTimeFormatted();
            const filename = `${documentTypeName}-${currentDate}.xml`;
            downloadXmlString(response.xml, filename);
        }
    }

    async function exportDocumentsTest() {
        const selected = document.querySelectorAll("#table-search-documents tbody input[type=checkbox]:checked");
        if (!selected) {
            alert("Selezionare almeno un documento dall'elenco.");
            return false;
        }

        const ids = Array.from(selected).map(input => input.dataset.id);
        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_test_export', {'type': 'order', 'id_order': 45668}) }}", {
            method: "GET",
            headers: {
                "Content-Type": "application/json",
                'X-Requested-With': 'XMLHttpRequest',
            }
        });

        const response = await request.json();
        console.log(response);
        console.log(JSON.stringify(response.document));
    }

    async function getTypeDocuments() {
        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_get_mvt_reason_id') }}", {
            method: "GET",
            headers: {
                "Content-Type": "application/json",
            }
        });

        const response = await request.json();
        document.getElementById("type-doc-ordine").value = response.document_types.order.id;
        document.getElementById("type-doc-invoice").value = response.document_types.invoice.id;
        document.getElementById("type-doc-delivery").value = response.document_types.delivery.id;
        document.getElementById("type-doc-return").value = response.document_types.return.id;
        document.getElementById("type-doc-credit-slip").value = response.document_types.credit_slip.id;
    }

    async function savePaymentModules() {
        if (confirm("Salvare i moduli di pagamento?") == false) {
            return false;
        }

        const selected = document.getElementById("select-payment-module").querySelectorAll("option:checked");
        const ids = Array.from(selected).map(option => option.value);

        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_save_payment_modules') }}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify({
                ids: ids,
            }),
        });

        const response = await request.json();

        if (response.success || false) {
            alert("Moduli di pagamento salvati.");
        } else {
            alert("Errore duranta il salvataggio dei moduli di pagamento.");
        }
    }

    async function setTypeDocuments() {
        if (confirm("Salvare i codici documento?") == false) {
            return false;
        }

        const request = await fetch("{{ path('mpstockadv_admin_stockimportexport_set_mvt_reason_id') }}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify({
                id_type_order: document.getElementById("type-doc-ordine").value,
                id_type_invoice: document.getElementById("type-doc-invoice").value,
                id_type_delivery: document.getElementById("type-doc-delivery").value,
                id_type_return: document.getElementById("type-doc-return").value,
                id_type_credit_slip: document.getElementById("type-doc-credit-slip").value,
            }),
        });

        const response = await request.json();

        if (response.success || false) {
            alert("Codici documento salvati.");
        } else {
            alert("Errore duranta il salvataggio dei codici.");
        }
    }

    async function bindPageNumbers() {
        const pagesNav = document.querySelectorAll(".page-link.page-navigation");
        console.log("Navigator:", pagesNav);

        if (pagesNav) {
            pagesNav.forEach(item => {
                item.addEventListener("click", async (e) => {
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    const button = e.target.closest("button");
                    const page = button.dataset.page;
                    console.log(`GO TO PAGE ${page}`);

                    await searchDocuments(page);
                });
            });
        }
    }

    function showLoadingOverlay(table) {
        // Crea l'overlay se non esiste già
        let overlay = table.querySelector('.table-loading-overlay');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.className = 'table-loading-overlay';
            overlay.innerHTML = `
                                    <div class="spinner-container">
                                        <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                `;
            table.appendChild(overlay);
        }

        // Posiziona l'overlay sopra il tbody
        const tbody = table.querySelector('tbody');
        if (tbody) {
            const rect = tbody.getBoundingClientRect();
            overlay.style.width = `${rect.width}px`;
            overlay.style.height = `${rect.height}px`;
            overlay.style.top = `${tbody.offsetTop}px`;
            overlay.style.left = `${tbody.offsetLeft}px`;
        }

        overlay.style.display = 'flex';
    }

    function appendStyle() { // CSS necessario
        const overlay_css = document.getElementById("overlay_table_css");
        if (!overlay_css) {
            const style = document.createElement('style');
            style.id = "overlay_table_css";
            style.textContent = `
                                    .table-loading-overlay {
                                        position: absolute;
                                        background: rgba(255, 255, 255, 0.7);
                                        display: none;
                                        justify-content: center;
                                        align-items: center;
                                        z-index: 1000;
                                        pointer-events: none;
                                    }
                                    
                                    .spinner-container {
                                        position: relative;
                                    }
                                    
                                    .spinner-border {
                                        width: 3rem;
                                        height: 3rem;
                                    }
                                `;
            document.head.appendChild(style);
        }
    }

    function hideLoadingOverlay(table) {
        const overlay = table.querySelector('.table-loading-overlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    document.addEventListener("DOMContentLoaded", async () => {
        appendStyle();
        const selectPaymentModules = document.getElementById("select-payment-module");
        $(selectPaymentModules).select2();

        const table = document.getElementById("table-search-documents")
        await getTypeDocuments();

        const btnSearchDocuments = document.getElementById("btn-search-documents");
        if (btnSearchDocuments) {
            btnSearchDocuments.addEventListener("click", async (e) => {
                const result = await searchDocuments();
                console.log("RESULT", result);
            });
        }

        const btnExportDocument = document.getElementById("btn-export-documents");
        if (btnExportDocument) {
            btnExportDocument.addEventListener("click", async (e) => {
                const result = await exportDocuments();
            });
        }

        const btnExportDocumentTest = document.getElementById("btn-export-documents-test");
        if (btnExportDocumentTest) {
            btnExportDocumentTest.addEventListener("click", async (e) => {
                const result = await exportDocumentsTest();
            });
        }

        const btnSaveDocumentsId = document.getElementById("save-id-type-documents");
        if (btnSaveDocumentsId) {
            btnSaveDocumentsId.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();

                setTypeDocuments();
            });
        }

        const btnSavePaymentModules = document.getElementById("btn-save-payment-modules");
        if (btnSavePaymentModules) {
            btnSavePaymentModules.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();

                savePaymentModules();
            });
        }

        const checkAllDocuments = document.getElementById("check_all_found_documents");
        if (checkAllDocuments) {
            checkAllDocuments.addEventListener("click", (e) => {
                const checked = e.target.checked;
                const checkboxes = table.querySelectorAll("input[type=checkbox]");
                checkboxes.forEach((item) => {
                    item.checked = checked;
                });
            });
        }
    });
</script>